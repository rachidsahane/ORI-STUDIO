From fd5ee062f8d839ef37801b650ff72e7e7e3949d3 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 18 Oct 2026 16:40:06 +0000
Subject: [PATCH 2/3] fix(watch): prove the look at the root alone and counted
 once, backend silenced

On Linux the backend reports a root's removal too, so tests that run
the real backend cannot tell the watcher's own look at the root from the
backend's report, nor catch a removal counted twice. Two tests end the
backend and keep the queue alive, so the test is the only source of what
the watcher is told, as on Windows: one shows a removal the backend
never reports is recorded by the look at the root alone, on a call in
which nothing arrived; the other shows a removal reported by both, in one
batch or a later one, is counted once.

Ticket: ORI-T-0163
Spec: ARCHITECTURE.md#5-data-flows
Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CQ4vWTcpGWb4B2jvnPi4RM
---
 crates/ori-watch/src/watcher.rs | 78 +++++++++++++++++++++++++++++++++
 1 file changed, 78 insertions(+)

diff --git a/crates/ori-watch/src/watcher.rs b/crates/ori-watch/src/watcher.rs
index f08dd6e..6138825 100644
--- a/crates/ori-watch/src/watcher.rs
+++ b/crates/ori-watch/src/watcher.rs
@@ -3712,6 +3712,84 @@ mod tests {
         assert_eq!(watcher.health(), Health::Watching);
     }
 
+    /// Ends the backend and keeps the queue alive, so the test is the only
+    /// source of what the watcher is told: the way `ReadDirectoryChangesW`
+    /// leaves a watcher whose root was removed, with nothing said.
+    fn silence_the_backend(watcher: &mut TreeWatcher) {
+        let backend = watcher.backend.take().expect("the backend is running");
+        drop(backend);
+    }
+
+    #[test]
+    fn ori_t_0163_a_removal_the_backend_never_reports_is_recorded_by_the_look_at_the_root() {
+        let scratch = Scratch::new("rootgone-silent");
+        let root = scratch.dir("root");
+        let mut watcher = TreeWatcher::watch_with(&root, quick()).unwrap();
+        silence_the_backend(&mut watcher);
+        // Whatever the backend queued before it was ended is delivered first;
+        // an intact root adds no loss to it.
+        while let Some(batch) = watcher.next_batch(Duration::from_millis(50)).unwrap() {
+            assert!(
+                batch.missed.is_none(),
+                "an intact root was recorded as lost: {:?}",
+                batch.missed
+            );
+        }
+        assert_eq!(watcher.health(), Health::Watching);
+
+        fs::remove_dir(&root).unwrap();
+        // Nothing arrived within the wait, and the answer is a batch anyway.
+        let batch = watcher
+            .next_batch(Duration::from_millis(50))
+            .unwrap()
+            .expect("a root that is gone is delivered, not read as a quiet tree");
+        let missed = batch.missed.expect("the batch carries the missed state");
+        assert_eq!(missed.reasons, vec![MissedReason::RootGone]);
+        assert_eq!(missed.occurrences, 1);
+        assert_eq!(watcher.health(), Health::MayHaveMissedChanges(missed));
+    }
+
+    #[test]
+    fn ori_t_0163_a_removal_reported_by_both_the_backend_and_the_look_is_counted_once() {
+        let scratch = Scratch::new("rootgone-twice");
+        let root = scratch.dir("root");
+        let mut watcher = TreeWatcher::watch_with(&root, quick()).unwrap();
+        silence_the_backend(&mut watcher);
+        fs::remove_dir(&root).unwrap();
+        let removal = |at: i64| Raw::Change {
+            path: root.clone(),
+            kind: ChangeKind::Removed,
+            at: Timestamp::from_millis(at),
+        };
+
+        // The backend's report and the look at the root meet in one batch.
+        watcher.inject(removal(5));
+        let batch = watcher
+            .next_batch(PATIENCE)
+            .unwrap()
+            .expect("the removal is delivered");
+        let missed = batch.missed.expect("the batch carries the missed state");
+        assert_eq!(missed.reasons, vec![MissedReason::RootGone]);
+        assert_eq!(missed.first_observed_at, Timestamp::from_millis(5));
+        assert_eq!(
+            missed.occurrences, 1,
+            "the look at the root counted a removal the backend had reported"
+        );
+
+        // The backend reports it again, in a later batch: held already.
+        watcher.inject(removal(6));
+        let batch = watcher
+            .next_batch(PATIENCE)
+            .unwrap()
+            .expect("the notice arrives as a batch");
+        assert!(
+            batch.missed.is_none(),
+            "a removal already held was recorded again: {:?}",
+            batch.missed
+        );
+        assert_eq!(held_missed_state(&watcher).occurrences, 1);
+    }
+
     #[test]
     fn ori_t_0054_a_root_that_is_missing_or_not_a_directory_is_refused() {
         let scratch = Scratch::new("badroot");
