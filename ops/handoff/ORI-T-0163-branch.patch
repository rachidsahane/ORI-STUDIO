+    /// Drains `watcher` until two calls in a row return `Ok(None)`, under
+    /// `PATIENCE`, and returns the batches it got on the way.
+    fn drain_until_quiet(watcher: &mut TreeWatcher) -> Vec<Batch> {
+        let deadline = Instant::now() + PATIENCE;
+        let mut batches = Vec::new();
+        let mut quiet_calls = 0;
+        while quiet_calls < 2 {
+            assert!(
+                Instant::now() < deadline,
+                "the watcher never fell quiet; drained {batches:?}"
+            );
+            match watcher
+                .next_batch(Duration::from_millis(150))
+                .expect("the watcher is still running")
+            {
+                Some(batch) => {
+                    quiet_calls = 0;
+                    batches.push(batch);
+                }
+                None => quiet_calls += 1,
+            }
+        }
+        batches
+    }
