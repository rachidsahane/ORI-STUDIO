+    /// Drains `watcher` until a batch carries `RootGone`, under `PATIENCE`, and
+    /// returns that batch's missed state. Whichever of the backend and the
+    /// watcher's own look at the root reports it first ends the wait.
+    fn drain_until_the_root_is_recorded(watcher: &mut TreeWatcher) -> MissedChanges {
+        let deadline = Instant::now() + PATIENCE;
+        loop {
+            assert!(
+                Instant::now() < deadline,
+                "the removal of the watched root was never recorded"
+            );
+            let batch = watcher
+                .next_batch(Duration::from_millis(300))
+                .expect("the watcher is still running");
+            if let Some(missed) = batch.and_then(|batch| batch.missed)
+                && missed.reasons.contains(&MissedReason::RootGone)
+            {
+                return missed;
+            }
+        }
+    }
