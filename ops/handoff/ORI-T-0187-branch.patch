+
+    /// Asserts what the marker may and may not reach: no reply, no `mcp.*` row
+    /// and no evidence row holds it.
+    fn assert_marker_stays_out(reply: &Reply, rows: &[ori_store::event_log::Event]) {
+        assert!(!wire(reply).to_string().contains(MARKER), "the reply");
+        for row in rows {
+            if row.kind().starts_with("mcp.") || row.kind() == "memory.evidence_stored" {
+                assert!(
+                    !row.payload().contains(MARKER),
+                    "{}: {}",
+                    row.kind(),
+                    row.payload()
+                );
+            }
+        }
+    }
+
+    fn marked(names: &[&str]) -> Map<String, Value> {
+        names
+            .iter()
+            .map(|name| ((*name).to_owned(), json!(format!("{MARKER} {name}"))))
+            .collect()
+    }
+
+    #[test]
+    fn ori_t_0187_no_agent_text_reaches_the_reply_or_the_calls_rows() {
+        // A recorded report: every field carries the marker.
+        let mut coder = rig(Role::Coder, "marker-coder", true);
+        let tip = coder.world.tip();
+        let reply = report(
+            &mut coder.world,
+            &ticket_t(),
+            "closing",
+            marked(&CLOSING_FIELDS),
+        );
+        assert_eq!(recorded_text(&reply), recorded_reply(1));
+        let rows = coder.world.rows_since(tip);
+        assert_marker_stays_out(&reply, &rows);
+        // The marker is expected in the record's structured text...
+        let created = rows.last().expect("the record row");
+        assert_eq!(created.kind(), "memory.record_created");
+        assert!(created.payload().contains(MARKER), "{}", created.payload());
+        // ... and in each evidence file.
+        let blobs = read_evidence(&mut coder.world.db).expect("the evidence reads");
+        assert_eq!(blobs.len(), 10);
+        for blob in &blobs {
+            let content = read_evidence_content(blob, READ_CAP).expect("the file reads");
+            assert!(content.text_lossy().contains(MARKER));
+        }
+
+        // An extra-key call: a blocked report, its five fields and a key that is
+        // the marker.
+        let tip = coder.world.tip();
+        let mut content = marked(&BLOCKED_FIELDS);
+        content.insert(MARKER.to_owned(), json!(format!("{MARKER} value")));
+        let reply = report(&mut coder.world, &ticket_t(), "blocked", content);
+        assert_failure(&reply, &invalid_object("content"));
+        let rows = coder.world.rows_since(tip);
+        assert_eq!(kinds(&rows), FAILED_ROWS);
+        assert_marker_stays_out(&reply, &rows);
+
+        // An unfiled-ticket call: a qa binding names a ticket nobody filed.
+        let mut qa = rig(Role::Qa, "marker-qa", true);
+        let tip = qa.world.tip();
+        let unfiled = id("UNFILED");
+        let reply = report(&mut qa.world, &unfiled, "blocked", marked(&BLOCKED_FIELDS));
+        assert_failure(&reply, &refused_object("ticket_not_in_product", 25));
+        let rows = qa.world.rows_since(tip);
+        assert_eq!(kinds(&rows), FAILED_ROWS);
+        assert_marker_stays_out(&reply, &rows);
+        assert_eq!(qa.draws(), 0);
+    }
