+                content.insert("budget_consumed".to_owned(), json!("   "));
+            },
+            "/content/budget_consumed",
+        );
+        case(
+            "precedence: a blank field, a missing one and an extra key",
+            &|content| {
+                content.insert("approaches_tried".to_owned(), json!(" \t\n "));
+                content.remove("what_it_needs_from_a_human");
+                content.insert(MARKER.to_owned(), json!("text"));
