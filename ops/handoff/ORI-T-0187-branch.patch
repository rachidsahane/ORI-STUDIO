+    // -------------------------------------------------------------------
+    // Pins that belong to no numbered test
+    // -------------------------------------------------------------------
+
+    #[test]
+    fn ori_t_0187_the_handlers_refusals_name_sections_that_resolve() {
+        for (code, section) in [
+            (CODE_KIND_NOT_PERMITTED, 17),
+            (CODE_KIND_NOT_AVAILABLE, 17),
+            (CODE_TICKET_NOT_IN_PRODUCT, 25),
+        ] {
+            match refused(code, section) {
+                HandlerError::Refused {
+                    code: found,
+                    methodology_ref,
+                } => {
+                    assert_eq!(found, code);
+                    assert_eq!(methodology_ref.section, section);
+                    assert!(methodology_ref.resolves(), "{code}");
+                }
+                other => panic!("expected a refusal, got {other:?}"),
+            }
+        }
+    }
