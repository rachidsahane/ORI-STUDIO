+//! The report tool `aicd_report`: AICD §8, AICD §25,
+//! `spec/API_SPEC.md` section 3.
+//!
+//! One handler, [`crate::tools::report::ReportHandler`], that the engine
+//! registers with [`crate::tools::Handlers::register`]. In `spec/API_SPEC.md`
+//! section 3's words, `aicd_report(ticket_id, kind, content)` files "closing,
+//! blocked, QA run and drift audit reports through the sanitization barrier".
+//! It is how an agent files the closing report and the blocked report that
+//! `CLAUDE.md` and AICD appendix A.5 require. The handler is the thin layer
+//! between S2's pipeline, which admits the four roles and validates the
+//! arguments against the catalogue's schema, and `ori_memory::barrier`, which
+//! sanitizes every field, writes each raw text to its evidence file and appends
+//! the record. **It writes no event of its own and no text but fixed labels.**
+//!
+//! # The kinds and who may write them
+//!
+//! `kind` is one of `closing`, `blocked`, `qa_run` and `drift_audit`
+//! (`crate::tools::REPORT_KINDS`). Each role may write only the kinds in this
+//! table (`spec/API_SPEC.md` section 3, "Report kinds"), and the handler holds
+//! the table itself, because S2 admits a role to the tool and not to a kind:
+//!
+//! | Role | May write |
+//! |---|---|
+//! | coder | `closing`, `blocked` |
+//! | documentation | `closing`, `drift_audit`, `blocked` |
+//! | qa | `qa_run`, `blocked` |
+//! | operations | `blocked` |
+//! | any other role | nothing: S2 refuses it first |
+//!
+//! Each kind is stored as one operational-memory record kind, and the fields of
+//! `content` are the names of its template, in template order
+//! (`templates/closing-report.md`, `templates/blocked-report.md`):
+//!
+//! | Kind | Stored as | Fields of `content`, in template order |
+//! |---|---|---|
+//! | `closing` | `closing_report` | [`crate::tools::report::CLOSING_FIELDS`]: `modules_touched`, `criteria_covered`, `outcome`, `approaches_tried_and_rejected`, `deviations_from_the_plan`, `escalation_decisions`, `specification_update`, `new_criteria`, `what_the_next_agent_should_know`, `provenance` |
+//! | `blocked` | `blocked_report` | [`crate::tools::report::BLOCKED_FIELDS`]: `budget_consumed`, `approaches_tried`, `hypothesis`, `what_it_would_try_next`, `what_it_needs_from_a_human` |
+//! | `qa_run` | `finding` | none: no template defines them yet |
+//! | `drift_audit` | `finding` | none: no template defines them yet |
+//!
+//! `spec/API_SPEC.md` section 3 says no file in `templates/` is a form for
+//! `qa_run` or `drift_audit`, so "until a template defines them, the server has
+//! no list of names to hold the `content` of these two kinds to". The handler
+//! therefore refuses both, `report_kind_not_available`. A template ticket must
+//! name their fields first, and then this file gains two lists and two arms.
+//!
+//! # One call
+//!
+//! S2 has already run every check and appended `mcp.tool_called` when the
+//! handler is reached ([`crate::tools::ToolHandler`]). The handler then makes
+//! **every check before it draws an identifier or writes a byte**, in this
+//! order:
+//!
+//! ```mermaid
+//! sequenceDiagram
+//!   participant A as agent
+//!   participant S as S2: Server::receive
+//!   participant H as ReportHandler
+//!   participant L as the product's log
+//!   participant I as the IdSource
+//!   participant B as barrier::submit_report
+//!   A->>S: tools/call aicd_report
+//!   S->>S: checks 0 to 7
+//!   S->>L: append mcp.tool_called
+//!   S->>H: call(db, BoundCall, arguments)
+//!   H->>H: the ticket, the kind, the role may write it, the kind has fields
+//!   H->>H: the content, field by field in template order, then no extra key
+//!   alt any of those fails
+//!     H-->>S: Refused or Port Invalid
+//!     S->>L: append mcp.tool_failed
+//!     S-->>A: an error result
+//!   else all pass
+//!     H->>L: verify and read the log: is the ticket filed?
+//!     alt not filed
+//!       H-->>S: Refused ticket_not_in_product
+//!       S->>L: append mcp.tool_failed
+//!       S-->>A: an error result
+//!     else filed
+//!       H->>I: next_id: the record, then one per field
+//!       H->>B: submit_report(db, call.at, the agent, request, config)
+//!       B->>L: memory.evidence_stored per field, then memory.record_created
+//!       alt the barrier or the id source failed
+//!         H-->>S: Port Unavailable
+//!         S->>L: append mcp.tool_failed
+//!         S-->>A: an error result
+//!       else recorded
+//!         H-->>S: Ok, one text block
+//!         S-->>A: that result as it is
+//!       end
+//!     end
+//!   end
+//! ```
+//!
+//! 1. **The ticket** is the call's `ticket_id`. None is `Port(Invalid)` at
+//!    `ticket_id`, unreachable after S2.
+//! 2. **The kind** is the `kind` argument. Anything but one of the four is
+//!    `Port(Invalid)` at `kind`, unreachable after S2's enumeration.
+//! 3. **The role may write the kind** (the first table). If not, the handler
+//!    refuses `report_kind_not_permitted_for_role`, AICD §17, the section S2's
+//!    `tool_not_permitted_for_role` uses.
+//! 4. **The kind has fields.** `qa_run` and `drift_audit` are refused
+//!    `report_kind_not_available`, AICD §17, the section S2's
+//!    `tool_not_available` uses.
+//! 5. **The content** is the `content` argument, an object (`Port(Invalid)` at
+//!    `content` otherwise, unreachable). The method, and so the order of the
+//!    faults: the handler walks **the kind's constant list in template order**
+//!    and removes each field from the map. The first field that is missing, not
+//!    a string (unreachable after S2) or blank is `Port(Invalid)` at
+//!    `/content/<name>`, and the walk stops. Only after the whole list passes,
+//!    a key left in the map is `Port(Invalid)` at `content`. So a missing or
+//!    blank field is reported before an extra key, and the first in template
+//!    order wins. A field name in a pointer is one of the handler's constants,
+//!    never an agent's key.
+//! 6. **The ticket is filed in this product.** The handler reads the log as
+//!    `ori_memory::scope` does (`EventLog::verify`, then `read_range` to the
+//!    tip) and looks for a `ticket.filed` event whose ticket column is the
+//!    ticket. Not filed is `ticket_not_in_product`, AICD §25, the code and
+//!    section the scope enforcer uses. A log that cannot be read is
+//!    `Port(Unavailable)`.
+//! 7. **The identifiers**, drawn only now: one for the record, then one per
+//!    field in template order.
+//! 8. **The request**: one `NewReportField` per field of the kind, in template
+//!    order, its name the handler's constant and its `raw_text` the agent's
+//!    value **unchanged**; a `NewReport` of the kind's record kind and the
+//!    ticket.
+//! 9. **Submit**: `barrier::submit_report` at the call's time, as the agent.
+//!    Any `BarrierError` is `Port(Unavailable)`, with a fixed `what`: the
+//!    error's own `Display` carries paths and is never copied.
+//! 10. **The reply**: one text block, no `structuredContent`, no `isError`.
+//!     `report recorded: record <record id>`, and when the barrier cut a field
+//!     to its cap, a second line naming the cap and the cut fields. The names
+//!     come from walking the kind's constant list in template order, never from
+//!     the barrier's set, which is in alphabetical order. **No agent text is in
+//!     the reply:** no key, no value, no error's `Display`.
+//!
+//! # The decisions this module carries
+//!
+//! **The ticket check is the handler's.** S2's check 7 ties only a coder to its
+//! bound ticket. Any other role's ticket passes S2 unchecked, and S2's own
+//! documentation says this slice must check that the ticket exists in this
+//! product. The check holds for every role, the coder included. It costs a
+//! second verify of the log per call, since the barrier makes one too; that is
+//! accepted, as S3's repeated passes were.
+//!
+//! **Every field of the kind is required, and none is blank.** The blocked
+//! report's five fields are required by their template. The closing report's
+//! `new_criteria` and `provenance` are required only for some tickets, and the
+//! handler does not interpret the ticket's kind, so all ten are required: an
+//! agent writes `none` where nothing applies. `none` is ordinary text.
+//!
+//! **The cap.** S2's schema accepts 8 192 characters per field, and the barrier
+//! keeps at most `BarrierConfig::field_cap_chars` (4 000 by default) of the
+//! sanitized text in the record. The raw text stays whole in the evidence file.
+//! The handler tells the agent which fields were cut (step 10), and the
+//! catalogue's bounds stay as S2 pinned them. The engine gives the handler the
+//! product's `BarrierConfig`.
+//!
+//! **A blocked report has no side effect here.** `spec/API_SPEC.md` section 3
+//! gives it none. The engine reacts to the record, whose kind is
+//! `blocked_report`. The `report.*` events and the Report row's `session_id`
+//! (`spec/DATA_MODEL.md` section 2) are for the specification ticket that
+//! reconciles them.
+//!
+//! **`budget_consumed` is stored as the agent wrote it.** The runtime's meter is
+//! the authority, and the engine compares the two.
+//!
+//! **One `NewReportField` per `content` entry, `raw_text` unchanged.** Slice S7
+//! (`aicd_evidence`) sized the budget of the raw evidence a record can hold on
+//! this: a record's evidence is at most one blob per field of its kind, ten for a
+//! closing report, each holding the agent's whole text. This handler never
+//! trims, joins, splits or rewrites a value.
+//!
+//! # What is recorded
+//!
+//! **The handler's own code appends nothing.** Every row of a recorded call
+//! after S2's own is the barrier's.
+//!
+//! | Outcome | Rows, in order |
+//! |---|---|
+//! | recorded | `mcp.tool_called` (ticket column: the argument), then one `memory.evidence_stored` per field in template order (the barrier's; ticket column: **the record id**, as the barrier writes it), then `memory.record_created` (ticket column: the ticket). All carry `call.at` and the agent as actor |
+//! | a refusal before the barrier: a kind not permitted or not available, a ticket not filed | `mcp.tool_called`, then `mcp.tool_failed` (`failure: refused`, the code, the section) |
+//! | a content fault | `mcp.tool_called`, then `mcp.tool_failed` (`failure: invalid`, the constant field) |
+//! | the identifiers, the log or the barrier failed | `mcp.tool_called`, then any evidence rows the barrier appended before it failed, then `mcp.tool_failed` (`failure: unavailable`) |
+//!
+//! **Nothing comes between the barrier's rows.** The scope enforcer attributes a
+//! record's evidence by walking back from the record's event over evidence rows
+//! of the same actor and time (`ori_memory::scope`). The barrier appends them
+//! all in one call, with nothing between, and the handler appends nothing before
+//! or after it. A barrier failure part-way leaves evidence rows that no record
+//! claims; the enforcer never hands those out.
+//!
+//! **The row bound.** An admitted call adds at most 11 rows of the barrier's: 10
+//! evidence rows and the record. With S2's own two rows (`mcp.tool_called` and
+//! `mcp.tool_failed`, or the first and the record's), a call leaves at most 12.
+//! So **calls to this tool leave at most twelve times the window's limit plus one
+//! row per connection** (`crate::server`'s module documentation bounds S2's own
+//! rows, and asks each slice to state its handler's).
+//!
+//! # Limits
+//!
+//! - **Until the engine writes `ticket.filed` (ORI-T-0070), every report is
+//!   refused `ticket_not_in_product`.** Nothing writes that event yet, and the
+//!   check holds for every role. The memory tools state the same limit.
+//! - **`none` is accepted in every field**, including those whose template does
+//!   not allow it. **`new_criteria` is required on every ticket**, although its
+//!   template requires it only for defects. A defect closed with
+//!   `new_criteria: none` is recorded as it is, for the lead's review.
+//! - **A field over the cap is cut in the record**, as above. The reply names it
+//!   and the evidence keeps the whole text.
+//! - **`qa_run` and `drift_audit` wait on a template** that names their fields.
+//! - **`drift_audit` will be stored as `finding`**, which the scope enforcer
+//!   files under `operational_defect`, a source documentation's memory scope
+//!   cannot read (`spec/ENV_SETUP.md` section 5). That is recorded for the
+//!   template ticket.
+//! - **The role is the binding's**, until condition 6 of E-0013 is met. The
+//!   handler makes no identity check of its own, and S2's check 5 and this
+//!   handler's role table both rest on the engine's binding.
+//! - **A qa or operations session must still name a ticket**: the schema
+//!   requires one, and it must be filed.
+//! - **The barrier's own AICD §8 refusals become `unavailable`** (step 9). That
+//!   drops `EvidenceWriteRefused` to "retry later", deliberately: since the field
+//!   names are the handler's constants and the identifiers are the engine's, none
+//!   is the agent's to fix.
+//! - **A record id's uniqueness rests on the `IdSource` alone.** The barrier
+//!   checks evidence ids against the log, never record ids. A repeated record id
+//!   is stored, and both records then become unreadable as evidence. The
+//!   engine's `IdSource` (ORI-T-0070) is the guard.
+//! - **The records this tool files are readable, as records, by the roles the
+//!   scope enforcer's table gives them**: `drift_audit`'s routing to
+//!   `operational_defect` is one case.
+//!
+//! # Tier
+//!
+//! Tier 2: `spec/RISK_MAP.md` lists `crates/ori-mcp/src/tools/` (a directory
+//! module, so that gate 12 tiers it), "What agents can do".
+
+use std::fmt;
+
+use ori_core::error::MethodologyRef;
+use ori_core::types::{Actor, Id, Role};
+use ori_memory::barrier::{self, BarrierConfig, FieldName, NewReport, NewReportField, RecordKind};
+use ori_store::db::ProductDb;
+use ori_store::event_log::EventLog;
+use serde_json::Value;
+
+use crate::ports::{IdSource, PortError};
+use crate::protocol::{CallToolResult, JsonObject};
+use crate::tools::{BoundCall, HandlerError, ToolHandler};
+
+/// The fields of a `closing` report's `content`, in the order of
+/// `templates/closing-report.md`: AICD §11, `spec/API_SPEC.md` section 3,
+/// "Report kinds".
+///
+/// They are exactly the names `spec/API_SPEC.md` gives, and a test pins them to
+/// that file. The report is stored as `closing_report`.
+///
+/// **An assumption these constants rest on.** `aicd_report` files **one**
+/// `NewReportField` per entry of `content`, with `raw_text` unchanged, so a
+/// closing report's record has ten evidence blobs, each holding the agent's whole
+/// text. Slice S7 (`aicd_evidence`) sized the budget of what it reads back on
+/// that.
+pub const CLOSING_FIELDS: [&str; 10] = [
+    "modules_touched",
+    "criteria_covered",
+    "outcome",
+    "approaches_tried_and_rejected",
+    "deviations_from_the_plan",
+    "escalation_decisions",
+    "specification_update",
+    "new_criteria",
+    "what_the_next_agent_should_know",
+    "provenance",
+];
+
+/// The fields of a `blocked` report's `content`, in the order of
+/// `templates/blocked-report.md`: AICD §12, AICD appendix A.5,
+/// `spec/API_SPEC.md` section 3, "Report kinds".
+///
+/// They are exactly the names `spec/API_SPEC.md` gives, and a test pins them to
+/// that file. The report is stored as `blocked_report`. As for
+/// [`crate::tools::report::CLOSING_FIELDS`], the handler files one
+/// `NewReportField` per entry, `raw_text` unchanged.
+pub const BLOCKED_FIELDS: [&str; 5] = [
+    "budget_consumed",
+    "approaches_tried",
+    "hypothesis",
+    "what_it_would_try_next",
+    "what_it_needs_from_a_human",
+];
+
+/// The JSON pointers of [`crate::tools::report::CLOSING_FIELDS`], one for one:
+/// constants, so that a fault names a field without ever building a pointer from
+/// an agent's key.
+const CLOSING_POINTERS: [&str; 10] = [
+    "/content/modules_touched",
+    "/content/criteria_covered",
+    "/content/outcome",
+    "/content/approaches_tried_and_rejected",
+    "/content/deviations_from_the_plan",
+    "/content/escalation_decisions",
+    "/content/specification_update",
+    "/content/new_criteria",
+    "/content/what_the_next_agent_should_know",
+    "/content/provenance",
+];
+
+/// The JSON pointers of [`crate::tools::report::BLOCKED_FIELDS`], one for one.
+const BLOCKED_POINTERS: [&str; 5] = [
+    "/content/budget_consumed",
+    "/content/approaches_tried",
+    "/content/hypothesis",
+    "/content/what_it_would_try_next",
+    "/content/what_it_needs_from_a_human",
+];
+
+/// The code of a report kind the role may not write: AICD §17.
+const CODE_KIND_NOT_PERMITTED: &str = "report_kind_not_permitted_for_role";
+/// The code of a report kind no template defines yet: AICD §17.
+const CODE_KIND_NOT_AVAILABLE: &str = "report_kind_not_available";
+/// The code of a ticket not filed in this product, the scope enforcer's own:
+/// AICD §25.
+const CODE_TICKET_NOT_IN_PRODUCT: &str = "ticket_not_in_product";
+
+/// The fixed sentence of a call that reaches the handler with no ticket.
+const WHY_TICKET: &str = "the call carries no ticket";
+/// The fixed sentence of a call whose kind is missing or is not one of the four.
+const WHY_KIND: &str = "the kind argument is missing or is not one of the four";
+/// The fixed sentence of a call whose content is missing or is not an object.
+const WHY_CONTENT: &str = "the content argument is missing or is not an object";
+/// The fixed sentence of a content that holds a key that is not a field of the
+/// kind.
+const WHY_UNEXPECTED: &str = "content holds a key that is not a field of this kind";
+/// The fixed sentence of a content that lacks a field of the kind.
+const WHY_MISSING: &str = "a field of this kind is missing";
+/// The fixed sentence of a content whose field of the kind is blank.
+const WHY_BLANK: &str = "a field of this kind is blank";
+/// The fixed sentence of a content whose field of the kind is not a string.
+const WHY_NOT_TEXT: &str = "a field of this kind is not a string";
+
+/// What was unavailable when the product's log cannot be read. Never copied
+/// into a reply or an event.
+const WHAT_LOG: &str = "the product's log";
+/// What was unavailable when the barrier or a field name failed. Never copied
+/// into a reply or an event, and never the barrier error's `Display`, which
+/// carries paths.
+const WHAT_STORE: &str = "the report store";
+
+/// The event kind that files a ticket in a product: AICD §11.
+const TICKET_FILED: &str = "ticket.filed";
+
+/// The kinds of report `aicd_report` takes, with the wire names of
+/// `crate::tools::REPORT_KINDS`: AICD §17.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum ReportKind {
+    Closing,
+    Blocked,
+    QaRun,
+    DriftAudit,
+}
+
+/// What a kind with a template is: the record kind it is stored as, and its
+/// field names with their pointers, both in template order.
+struct Form {
+    record_kind: RecordKind,
+    names: &'static [&'static str],
+    pointers: &'static [&'static str],
+}
+
+impl ReportKind {
+    /// The kind a wire name spells, or `None` for anything else.
+    fn parse(text: &str) -> Option<Self> {
+        match text {
+            "closing" => Some(Self::Closing),
+            "blocked" => Some(Self::Blocked),
+            "qa_run" => Some(Self::QaRun),
+            "drift_audit" => Some(Self::DriftAudit),
+            _ => None,
+        }
+    }
+
+    /// Whether `role` may write this kind: `spec/API_SPEC.md` section 3,
+    /// "Report kinds". One exhaustive `match` on the role, no wildcard.
+    const fn written_by(self, role: Role) -> bool {
+        match role {
+            Role::Coder => matches!(self, Self::Closing | Self::Blocked),
+            Role::Documentation => {
+                matches!(self, Self::Closing | Self::DriftAudit | Self::Blocked)
+            }
+            Role::Qa => matches!(self, Self::QaRun | Self::Blocked),
+            Role::Operations => matches!(self, Self::Blocked),
+            Role::Lead | Role::ProductSignal | Role::Assistant => false,
+        }
+    }
+
+    /// The kind's template, or `None` for a kind no template defines yet.
+    const fn form(self) -> Option<Form> {
+        match self {
+            Self::Closing => Some(Form {
+                record_kind: RecordKind::ClosingReport,
+                names: &CLOSING_FIELDS,
+                pointers: &CLOSING_POINTERS,
+            }),
+            Self::Blocked => Some(Form {
+                record_kind: RecordKind::BlockedReport,
+                names: &BLOCKED_FIELDS,
+                pointers: &BLOCKED_POINTERS,
+            }),
+            Self::QaRun | Self::DriftAudit => None,
+        }
+    }
+}
+
+/// A refusal under AICD §`section`, a whole section: the handler's own refusals
+/// all name one of §17 and §25.
+fn refused(code: &'static str, section: u8) -> HandlerError {
+    HandlerError::Refused {
+        code,
+        methodology_ref: MethodologyRef {
+            section,
+            subsection: None,
+        },
+    }
+}
+
+/// An `Invalid` failure at `field`, a constant, with one of the fixed `why`
+/// sentences: never built from an agent's key or value.
+fn invalid(field: &'static str, why: &str) -> HandlerError {
+    HandlerError::Port(PortError::Invalid {
+        field,
+        why: why.to_owned(),
+    })
+}
+
+/// An `Unavailable` failure of the effect, with a fixed `what` that S2 never
+/// copies into a reply or an event.
+fn unavailable(what: &str) -> HandlerError {
+    HandlerError::Port(PortError::Unavailable {
+        what: what.to_owned(),
+    })
+}
+
+/// The texts of `form`'s fields, taken out of `content` in template order: the
+/// method of step 5, AICD §27.
+///
+/// The first field that is missing, not a string or blank (it trims to empty)
+/// is the fault, and the walk stops. Only after the whole list passes is a key
+/// left in the map a fault. The map is a `BTreeMap`, and its keys are the
+/// agent's text, so the list is walked and the map is never iterated.
+fn take_fields(form: &Form, mut content: JsonObject) -> Result<Vec<String>, HandlerError> {
+    let mut texts = Vec::with_capacity(form.names.len());
+    for (name, pointer) in form.names.iter().zip(form.pointers) {
+        match content.remove(*name) {
+            None => return Err(invalid(pointer, WHY_MISSING)),
+            Some(Value::String(text)) if text.trim().is_empty() => {
+                return Err(invalid(pointer, WHY_BLANK));
+            }
+            Some(Value::String(text)) => texts.push(text),
+            Some(_) => return Err(invalid(pointer, WHY_NOT_TEXT)),
+        }
+    }
+    if content.is_empty() {
+        Ok(texts)
+    } else {
+        Err(invalid("content", WHY_UNEXPECTED))
+    }
+}
+
+/// Whether `ticket` is filed in `db`'s product: the log, verified and read to
+/// its tip as `ori_memory::scope` reads it, holds a `ticket.filed` event whose
+/// ticket column is the ticket (AICD §25).
+///
+/// A log that cannot be verified or read is `Unavailable`, with a fixed `what`.
+fn ticket_is_filed(db: &mut ProductDb, ticket: &Id) -> Result<bool, HandlerError> {
+    let report = EventLog::verify(db.connection()).map_err(|_| unavailable(WHAT_LOG))?;
+    let Some(tip) = report.tip_seq else {
+        return Ok(false);
+    };
+    let events =
+        EventLog::read_range(db.connection(), 1, tip).map_err(|_| unavailable(WHAT_LOG))?;
+    Ok(events
+        .iter()
+        .any(|event| event.kind() == TICKET_FILED && event.ticket_id() == Some(ticket)))
+}
+
+/// The handler of `aicd_report(ticket_id, kind, content)`: closing and blocked
+/// reports through the sanitization barrier (AICD §8, AICD §25).
+///
+/// It holds the engine's source of identifiers and the product's
+/// `BarrierConfig` (`field_cap_chars`, 4 000 by default), and nothing else:
+/// **no state across calls, no event of its own and no text but fixed labels.**
+/// `ori_memory::barrier::submit_report` sanitizes every field, writes each raw
+/// text to its evidence file and appends the record. See the module
+/// documentation for the kinds, the order of the checks, the rows a call leaves
+/// and the limits.
+///
+/// # Examples
+///
+/// The engine registers one handler for the tool, with its own `IdSource` (a
+/// ULID needs a clock and a source of randomness, which only the engine has) and
+/// the product's `BarrierConfig`. This one answers nothing, since registering
+/// draws no identifier.
+///
+/// ```
+/// use ori_core::types::Id;
+/// use ori_mcp::ports::{IdSource, PortError};
+/// use ori_mcp::scopes::Tool;
+/// use ori_mcp::tools::Handlers;
+/// use ori_mcp::tools::report::ReportHandler;
+/// use ori_memory::barrier::BarrierConfig;
+///
+/// struct NoIds;
+///
+/// impl IdSource for NoIds {
+///     fn next_id(&mut self) -> Result<Id, PortError> {
+///         Err(PortError::Unavailable {
+///             what: "the example's id source".to_owned(),
+///         })
+///     }
+/// }
+///
+/// let mut handlers = Handlers::new();
+/// handlers
+///     .register(
+///         Tool::Report,
+///         Box::new(ReportHandler::new(Box::new(NoIds), BarrierConfig::default())),
+///     )
+///     .expect("one handler per tool");
+/// assert!(handlers.is_registered(Tool::Report));
+/// ```
+pub struct ReportHandler {
+    ids: Box<dyn IdSource + Send>,
+    config: BarrierConfig,
+}
+
+impl ReportHandler {
+    /// A handler that draws its identifiers from `ids` and sanitizes with
+    /// `config`: AICD §8.
+    ///
+    /// A record's uniqueness rests on `ids` alone: the barrier checks evidence
+    /// ids against the log, never record ids.
+    #[must_use]
+    pub fn new(ids: Box<dyn IdSource + Send>, config: BarrierConfig) -> Self {
+        Self { ids, config }
+    }
+}
+
+impl fmt::Debug for ReportHandler {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("ReportHandler")
+            .field("config", &self.config)
+            .finish_non_exhaustive()
+    }
+}
+
+impl ToolHandler for ReportHandler {
+    /// `aicd_report`: check the call, draw the identifiers, submit the report
+    /// through the barrier, and answer with the record's identifier: AICD §8,
+    /// AICD §25.
+    ///
+    /// # Errors
+    ///
+    /// `Refused` for a kind the role may not write
+    /// (`report_kind_not_permitted_for_role`) or no template defines
+    /// (`report_kind_not_available`), both AICD §17, and for a ticket not filed
+    /// in this product (`ticket_not_in_product`, AICD §25);
+    /// `Port(Invalid)` for a content that lacks a field of its kind, holds one
+    /// that is blank, or holds a key that is not a field, and for a call whose
+    /// ticket, kind or content S2's schema makes unreachable;
+    /// `Port(Unavailable)` for a log that cannot be read, an identifier source
+    /// that cannot answer, or a barrier that failed or refused.
+    fn call(
+        &mut self,
+        db: &mut ProductDb,
+        call: &BoundCall<'_>,
+        mut arguments: JsonObject,
+    ) -> Result<CallToolResult, HandlerError> {
+        // 1. The ticket.
+        let Some(ticket) = call.ticket_id else {
+            return Err(invalid("ticket_id", WHY_TICKET));
+        };
+
+        // 2. The kind.
+        let kind = match arguments.remove("kind") {
+            Some(Value::String(text)) => ReportKind::parse(&text),
+            _ => None,
+        };
+        let Some(kind) = kind else {
+            return Err(invalid("kind", WHY_KIND));
+        };
+
+        // 3. The role may write the kind.
+        if !kind.written_by(call.binding.role()) {
+            return Err(refused(CODE_KIND_NOT_PERMITTED, 17));
+        }
+
+        // 4. The kind has fields.
+        let Some(form) = kind.form() else {
+            return Err(refused(CODE_KIND_NOT_AVAILABLE, 17));
+        };
+
+        // 5. The content, in template order.
+        let Some(Value::Object(content)) = arguments.remove("content") else {
+            return Err(invalid("content", WHY_CONTENT));
+        };
+        let texts = take_fields(&form, content)?;
+
+        // 6. The ticket is filed in this product.
+        if !ticket_is_filed(db, ticket)? {
+            return Err(refused(CODE_TICKET_NOT_IN_PRODUCT, 25));
+        }
+
+        // 7 and 8. The identifiers, drawn only now, and the request.
+        let record_id = self.ids.next_id()?;
+        let mut fields = Vec::with_capacity(texts.len());
+        for (name, raw_text) in form.names.iter().zip(texts) {
+            let evidence_id = self.ids.next_id()?;
+            fields.push(NewReportField {
+                name: FieldName::parse(name).map_err(|_| unavailable(WHAT_STORE))?,
+                raw_text,
+                evidence_id,
+            });
+        }
+        let request = NewReport {
+            record_id: record_id.clone(),
+            kind: form.record_kind,
+            ticket_id: Some(ticket.clone()),
+            fields,
+        };
+
+        // 9. Submit.
+        let submission = barrier::submit_report(
+            db,
+            call.at,
+            Actor::Agent(call.binding.identity().clone()),
+            request,
+            &self.config,
+        )
+        .map_err(|_| unavailable(WHAT_STORE))?;
+
+        // 10. The reply: the record, and the fields the cap cut, by walking the
+        // kind's list in template order (the barrier's set is alphabetical).
+        let cut: Vec<&str> = form
+            .names
+            .iter()
+            .copied()
+            .filter(|name| {
+                submission
+                    .truncated_fields()
+                    .iter()
+                    .any(|field| field.as_str() == *name)
+            })
+            .collect();
+        let mut reply = format!("report recorded: record {record_id}\n");
+        if !cut.is_empty() {
+            reply = format!(
+                "{reply}cut at the barrier's cap of {} characters, the evidence keeps the whole text: {}\n",
+                self.config.field_cap_chars,
+                cut.join(", ")
+            );
+        }
+        Ok(CallToolResult::text(reply))
+    }
+}
