+
+    /// A text only the tests' fields and keys carry: the planted marker.
+    const MARKER: &str = "ZEBRAQUARTZ0187";
+
+    /// The rows of a call refused or failed before any barrier row.
+    const FAILED_ROWS: [&str; 2] = ["mcp.tool_called", "mcp.tool_failed"];
+
+    /// The most bytes a test reads back from an evidence file.
+    const READ_CAP: u64 = 1 << 20;
+
+    // -------------------------------------------------------------------
+    // The scripted identifier source and the worlds
+    // -------------------------------------------------------------------
+
+    /// An identifier source that hands out ids from a list, counts how many
+    /// draws it was asked for in a counter the test shares, and can be told to
+    /// fail every draw. A list that runs out fails too, so no draw panics.
+    struct ScriptedIds {
+        script: Vec<Id>,
+        next: usize,
+        drawn: Arc<AtomicUsize>,
+        fails: bool,
+    }
+
+    impl IdSource for ScriptedIds {
+        fn next_id(&mut self) -> Result<Id, PortError> {
+            self.drawn.fetch_add(1, Ordering::SeqCst);
+            let unavailable = || PortError::Unavailable {
+                what: "the scripted id source".to_owned(),
+            };
+            if self.fails {
+                return Err(unavailable());
+            }
+            let id = self
+                .script
+                .get(self.next)
+                .cloned()
+                .ok_or_else(unavailable)?;
+            self.next += 1;
+            Ok(id)
+        }
+    }
+
+    /// The identifier of draw `n`: distinct for every `n` from 0 to 999.
+    fn numbered(n: usize) -> Id {
+        id(&format!("RPT{n:03}"))
+    }
+
+    /// The identifiers of draws `from` to `to`, both included.
+    fn numbers(from: usize, to: usize) -> Vec<Id> {
+        (from..=to).map(numbered).collect()
+    }
+
+    /// A world with a server bound to `role`, its report handler registered over
+    /// a scripted id source, and the number of identifiers drawn so far.
+    struct Rig {
+        world: World,
+        drawn: Arc<AtomicUsize>,
+    }
+
+    impl Rig {
+        fn draws(&self) -> usize {
+            self.drawn.load(Ordering::SeqCst)
+        }
+    }
+
+    fn rig_with(
+        role: Role,
+        label: &str,
+        ids: impl FnOnce(Arc<AtomicUsize>) -> ScriptedIds,
+        config: BarrierConfig,
+        filed: bool,
+    ) -> Rig {
+        let drawn = Arc::new(AtomicUsize::new(0));
+        let ids = ids(Arc::clone(&drawn));
+        // A coder is bound to its ticket; the other roles name one as an
+        // argument and are bound to none.
+        let bound = (role == Role::Coder).then(ticket_t);
+        let mut world = Setup::new(role, bound).build_with(label, move |_| {
+            let mut handlers = Handlers::new();
+            handlers
+                .register(
+                    Tool::Report,
+                    Box::new(ReportHandler::new(Box::new(ids), config)),
+                )
+                .expect("one handler per tool");
+            handlers
+        });
+        if filed {
+            let product = world.product.clone();
+            file_ticket(&mut world.db, &product, &ticket_t());
+        }
+        Rig { world, drawn }
+    }
+
+    /// A rig whose id source hands out draws 1 to 40 in order.
+    fn rig(role: Role, label: &str, filed: bool) -> Rig {
+        rig_with(
+            role,
+            label,
+            |drawn| ScriptedIds {
+                script: numbers(1, 40),
+                next: 0,
+                drawn,
+                fails: false,
+            },
+            BarrierConfig::default(),
+            filed,
+        )
+    }
+
+    // -------------------------------------------------------------------
+    // Arguments, rows and replies
+    // -------------------------------------------------------------------
+
+    /// A content map holding every name of `names`, each with its own text.
+    fn content_of(names: &[&str]) -> Map<String, Value> {
+        names
+            .iter()
+            .map(|name| ((*name).to_owned(), json!(format!("the text of {name}"))))
+            .collect()
+    }
+
+    /// The arguments of one `aicd_report` call.
+    fn arguments(ticket: &Id, kind: &str, content: Map<String, Value>) -> Value {
+        json!({"ticket_id": ticket.as_str(), "kind": kind, "content": content})
+    }
+
+    fn report(world: &mut World, ticket: &Id, kind: &str, content: Map<String, Value>) -> Reply {
+        world.call("aicd_report", arguments(ticket, kind, content))
+    }
+
+    /// The `structuredContent` of an error result that refused under `code`,
+    /// section `section`.
+    fn refused_object(code: &str, section: u8) -> Value {
+        json!({
+            "failure": "refused",
+            "reason": code,
+            "methodology_ref": {"section": section, "subsection": null},
+        })
+    }
+
+    fn invalid_object(field: &str) -> Value {
+        json!({"failure": "invalid", "field": field})
+    }
+
+    /// Asserts a failure's reply: an error result whose `structuredContent` is
+    /// exactly `expected`, with the text block that same object serialized.
+    fn assert_failure(reply: &Reply, expected: &Value) {
+        assert!(!reply.close && reply.unrecorded.is_none());
+        let message = wire(reply);
+        assert_eq!(message["result"]["isError"], true, "{message}");
+        assert_eq!(
+            message["result"]["structuredContent"], *expected,
+            "{message}"
+        );
+        let text: Value = serde_json::from_str(&text_of(reply)).expect("JSON text");
+        assert_eq!(text, *expected);
+    }
+
+    /// Asserts a recorded report's reply, and returns its one text block: no
+    /// `structuredContent` and no `isError`.
+    fn recorded_text(reply: &Reply) -> String {
+        assert!(!reply.close && reply.unrecorded.is_none());
+        let message = wire(reply);
+        let result = &message["result"];
+        assert!(result.get("isError").is_none(), "{message}");
+        assert!(result.get("structuredContent").is_none(), "{message}");
+        text_of(reply)
+    }
+
+    /// The reply of a recorded report whose record is draw `n` and which cut
+    /// nothing.
+    fn recorded_reply(n: usize) -> String {
+        format!("report recorded: record {}\n", numbered(n))
+    }
+
+    /// Asserts a call that left the two rows of a failure, drew no identifier
+    /// and wrote no file in the product's evidence directory.
+    fn assert_stopped_before_the_barrier(rig: &mut Rig, tip: u64) {
+        let rows = rig.world.rows_since(tip);
+        assert_eq!(kinds(&rows), FAILED_ROWS);
+        assert_eq!(rig.draws(), 0, "no identifier was drawn");
+        let evidence_dir = rig.world.db.dir().join("evidence");
+        assert_eq!(
+            fs::read_dir(&evidence_dir)
+                .expect("the evidence dir")
+                .count(),
+            0,
+            "no evidence file was written"
+        );
+    }
