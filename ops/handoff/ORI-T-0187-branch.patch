+    // -------------------------------------------------------------------
+    // 11. The field lists are the specification's
+    // -------------------------------------------------------------------
+
+    #[test]
+    fn ori_t_0187_the_field_lists_are_api_specs() {
+        let spec = include_str!("../../../../spec/API_SPEC.md");
+        // The cells of the table row starting with `prefix`, trimmed. Cell 0 is
+        // empty (the text before the first bar): cell 1 is the kind, cell 2 the
+        // record kind it is stored as, cell 3 the fields.
+        let cells = |prefix: &str| -> Vec<&str> {
+            let line = spec
+                .lines()
+                .find(|line| line.starts_with(prefix))
+                .unwrap_or_else(|| panic!("no row starts with {prefix}"));
+            line.split('|').map(str::trim).collect()
+        };
+        let names = |cell: &str| -> Vec<String> {
+            cell.split('`')
+                .skip(1)
+                .step_by(2)
+                .map(str::to_owned)
+                .collect()
+        };
+
+        let closing = cells("| `closing` | ");
+        assert_eq!(
+            closing[2],
+            format!("`{}`", RecordKind::ClosingReport.as_str())
+        );
+        assert_eq!(names(closing[3]), CLOSING_FIELDS);
+
+        let blocked = cells("| `blocked` | ");
+        assert_eq!(
+            blocked[2],
+            format!("`{}`", RecordKind::BlockedReport.as_str())
+        );
+        assert_eq!(names(blocked[3]), BLOCKED_FIELDS);
+
+        // The pointers are the lists' names, one for one, and the handler's
+        // kinds are the catalogue's.
+        for (name, pointer) in CLOSING_FIELDS.iter().zip(CLOSING_POINTERS) {
+            assert_eq!(pointer, format!("/content/{name}"));
+        }
+        for (name, pointer) in BLOCKED_FIELDS.iter().zip(BLOCKED_POINTERS) {
+            assert_eq!(pointer, format!("/content/{name}"));
+        }
+        assert_eq!(
+            REPORT_KINDS.map(ReportKind::parse),
+            [
+                Some(ReportKind::Closing),
+                Some(ReportKind::Blocked),
+                Some(ReportKind::QaRun),
+                Some(ReportKind::DriftAudit),
+            ]
+        );
+    }
