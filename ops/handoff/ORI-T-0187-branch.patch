+    // -------------------------------------------------------------------
+    // 14. Every role and every kind is decided
+    // -------------------------------------------------------------------
+
+    /// What a role writing a kind with `content: {}` is answered.
+    #[derive(Clone, Copy)]
+    enum Decision {
+        /// Permitted and available: held to the kind's fields, the first of
+        /// which is missing.
+        Invalid(&'static str),
+        /// Permitted, and no template defines the kind.
+        NotAvailable,
+        /// Not permitted for the role.
+        NotPermitted,
+    }
+
+    #[test]
+    fn ori_t_0187_every_role_and_kind_is_decided() {
+        use Decision::{Invalid, NotAvailable, NotPermitted};
+        const FIRST_CLOSING: &str = "/content/modules_touched";
+        const FIRST_BLOCKED: &str = "/content/budget_consumed";
+        let table: [(Role, &str, Decision); 16] = [
+            (Role::Coder, "closing", Invalid(FIRST_CLOSING)),
+            (Role::Coder, "blocked", Invalid(FIRST_BLOCKED)),
+            (Role::Coder, "qa_run", NotPermitted),
+            (Role::Coder, "drift_audit", NotPermitted),
+            (Role::Documentation, "closing", Invalid(FIRST_CLOSING)),
+            (Role::Documentation, "blocked", Invalid(FIRST_BLOCKED)),
+            (Role::Documentation, "qa_run", NotPermitted),
+            (Role::Documentation, "drift_audit", NotAvailable),
+            (Role::Qa, "closing", NotPermitted),
+            (Role::Qa, "blocked", Invalid(FIRST_BLOCKED)),
+            (Role::Qa, "qa_run", NotAvailable),
+            (Role::Qa, "drift_audit", NotPermitted),
+            (Role::Operations, "closing", NotPermitted),
+            (Role::Operations, "blocked", Invalid(FIRST_BLOCKED)),
+            (Role::Operations, "qa_run", NotPermitted),
+            (Role::Operations, "drift_audit", NotPermitted),
+        ];
+        // Four roles, each against every kind the catalogue lists.
+        for kind in REPORT_KINDS {
+            assert_eq!(table.iter().filter(|(_, k, _)| *k == kind).count(), 4);
+        }
+
+        for role in [Role::Coder, Role::Documentation, Role::Qa, Role::Operations] {
+            let mut rig = rig(role, &format!("matrix-{role}"), true);
+            for (_, kind, decision) in table.iter().filter(|(r, _, _)| *r == role) {
+                let tip = rig.world.tip();
+                let reply = report(&mut rig.world, &ticket_t(), kind, Map::new());
+                let expected = match decision {
+                    Invalid(field) => invalid_object(field),
+                    NotAvailable => refused_object("report_kind_not_available", 17),
+                    NotPermitted => refused_object("report_kind_not_permitted_for_role", 17),
+                };
+                assert_failure(&reply, &expected);
+                assert_stopped_before_the_barrier(&mut rig, tip);
+            }
+        }
+
+        // The roles S2 refuses first are refused by the handler too, should
+        // one ever reach it: through a direct call, for every kind.
+        for role in [Role::Lead, Role::ProductSignal, Role::Assistant] {
+            let mut rig = rig(Role::Coder, &format!("matrix-direct-{role}"), true);
+            let binding =
+                Binding::new(session(), identity(), role, rig.world.product.clone(), None);
+            let ticket = ticket_t();
+            let call = BoundCall {
+                binding: &binding,
+                tool: Tool::Report,
+                called_seq: 1,
+                at: Timestamp::from_millis(START),
+                ticket_id: Some(&ticket),
+            };
+            let mut handler = ReportHandler::new(
+                Box::new(ScriptedIds {
+                    script: Vec::new(),
+                    next: 0,
+                    drawn: Arc::clone(&rig.drawn),
+                    fails: false,
+                }),
+                BarrierConfig::default(),
+            );
+            for kind in REPORT_KINDS {
+                let Value::Object(arguments) = arguments(&ticket, kind, Map::new()) else {
+                    panic!("an object");
+                };
+                let result = handler.call(&mut rig.world.db, &call, arguments);
+                match result {
+                    Err(error @ HandlerError::Refused { .. }) => {
+                        assert_eq!(error, refused(CODE_KIND_NOT_PERMITTED, 17), "{role} {kind}");
+                    }
+                    other => panic!("{role} {kind}: expected a refusal, got {other:?}"),
+                }
+            }
+            assert_eq!(rig.draws(), 0);
+        }
+    }
