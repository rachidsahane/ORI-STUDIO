+    #[test]
+    fn ori_t_0187_content_is_held_to_the_kinds_fields() {
+        let mut rig = rig(Role::Coder, "content-faults", true);
+
+        // Each case is a blocked report, five fields, so an extra key stays
+        // within S2's ten. `change` edits the five good fields.
+        let mut case = |label: &str, change: &dyn Fn(&mut Map<String, Value>), field: &str| {
+            let tip = rig.world.tip();
+            let mut content = content_of(&BLOCKED_FIELDS);
+            change(&mut content);
+            let reply = report(&mut rig.world, &ticket_t(), "blocked", content);
+            assert_failure(&reply, &invalid_object(field));
+            assert_stopped_before_the_barrier(&mut rig, tip);
+            let rows = rig.world.rows_since(tip);
+            let failed = payload(&rows[1]);
+            assert_eq!(failed["failure"], "invalid", "{label}");
+            assert_eq!(failed["field"], field, "{label}");
+            assert!(failed.get("why").is_none(), "{label}: why is never copied");
+            for row in &rows {
+                assert!(
+                    !row.payload().contains(MARKER),
+                    "{label}: {}",
+                    row.payload()
+                );
+            }
+            assert!(!wire(&reply).to_string().contains(MARKER), "{label}");
+        };
+
+        case(
+            "an extra key",
+            &|content| {
+                content.insert(MARKER.to_owned(), json!("text"));
+            },
+            "content",
+        );
+        case(
+            "hypothesis missing",
+            &|content| {
+                content.remove("hypothesis");
+            },
+            "/content/hypothesis",
+        );
+        case(
+            "two missing: the first in template order wins",
+            &|content| {
+                content.remove("approaches_tried");
+                content.remove("budget_consumed");
