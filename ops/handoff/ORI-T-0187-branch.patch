+
+    #[test]
+    fn ori_t_0187_a_coder_files_a_closing_report_through_the_barrier() {
+        let mut rig = rig(Role::Coder, "report-closing", true);
+        let tip = rig.world.tip();
+
+        let reply = report(
+            &mut rig.world,
+            &ticket_t(),
+            "closing",
+            content_of(&CLOSING_FIELDS),
+        );
+        assert_eq!(recorded_text(&reply), recorded_reply(1));
+        assert_eq!(rig.draws(), 11, "the record, then one per field");
+
+        // The rows: the call's, ten evidence rows in template order, the record.
+        let rows = rig.world.rows_since(tip);
+        let mut expected = vec!["mcp.tool_called"];
+        expected.extend(["memory.evidence_stored"; 10]);
+        expected.push("memory.record_created");
+        assert_eq!(kinds(&rows), expected);
+        assert_eq!(payload(&rows[0])["tool"], "aicd_report");
+        assert_eq!(rows[0].ticket_id(), Some(&ticket_t()), "the argument");
+
+        // Provenance: the agent, at the call's time, on every barrier row.
+        let at = rows[0].at();
+        assert_eq!(at, Timestamp::from_millis(START));
+        for row in &rows {
+            assert_eq!(row.actor(), &Actor::Agent(identity()), "{}", row.kind());
+            assert_eq!(row.at(), at, "{}", row.kind());
+        }
+        for row in &rows[1..11] {
+            assert_eq!(row.ticket_id(), Some(&numbered(1)), "the record id");
+        }
+        assert_eq!(rows[11].ticket_id(), Some(&ticket_t()), "the ticket");
+
+        // The record: one, of the kind, with the ten names and no other.
+        let records = read_records(&mut rig.world.db).expect("the records read");
+        assert_eq!(records.len(), 1);
+        let record = &records[0];
+        assert_eq!(record.id(), &numbered(1));
+        assert_eq!(record.kind(), RecordKind::ClosingReport);
+        assert_eq!(record.provenance().ticket_id(), Some(&ticket_t()));
+        assert_eq!(record.provenance().actor(), &Actor::Agent(identity()));
+        assert_eq!(record.provenance().at(), at);
+        let mut names: Vec<&str> = record.structured().keys().map(FieldName::as_str).collect();
+        let mut expected_names = CLOSING_FIELDS.to_vec();
+        names.sort_unstable();
+        expected_names.sort_unstable();
+        assert_eq!(names, expected_names);
+
+        // The evidence: ten blobs in template order, each the field's whole text.
+        let blobs = read_evidence(&mut rig.world.db).expect("the evidence reads");
+        assert_eq!(blobs.len(), 10);
+        for (index, (blob, name)) in blobs.iter().zip(CLOSING_FIELDS).enumerate() {
+            assert_eq!(blob.id(), &numbered(index + 2), "{name}");
+            assert_eq!(blob.record_id(), &numbered(1), "{name}");
+            let content = read_evidence_content(blob, READ_CAP).expect("the file reads");
+            assert_eq!(
+                content.bytes(),
+                format!("the text of {name}").as_bytes(),
+                "{name}"
+            );
+        }
+    }
