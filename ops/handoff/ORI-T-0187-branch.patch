+    // -------------------------------------------------------------------
+    // 13. The fallbacks never panic
+    // -------------------------------------------------------------------
+
+    /// Calls the handler directly, as the coder bound to ticket T, with
+    /// `ticket` as the call's ticket argument and `arguments` as they are.
+    fn direct(
+        rig: &mut Rig,
+        ticket: Option<&Id>,
+        arguments: Value,
+    ) -> Result<CallToolResult, HandlerError> {
+        let mut handler = ReportHandler::new(
+            Box::new(ScriptedIds {
+                script: numbers(1, 40),
+                next: 0,
+                drawn: Arc::clone(&rig.drawn),
+                fails: false,
+            }),
+            BarrierConfig::default(),
+        );
+        let binding = Binding::new(
+            session(),
+            identity(),
+            Role::Coder,
+            rig.world.product.clone(),
+            Some(ticket_t()),
+        );
+        let call = BoundCall {
+            binding: &binding,
+            tool: Tool::Report,
+            called_seq: 1,
+            at: Timestamp::from_millis(START),
+            ticket_id: ticket,
+        };
+        let Value::Object(arguments) = arguments else {
+            panic!("an object");
+        };
+        handler.call(&mut rig.world.db, &call, arguments)
+    }
+
+    /// Asserts an `Invalid` failure at `field`, with `why` as the named constant.
+    fn assert_invalid(result: Result<CallToolResult, HandlerError>, field: &str, why: &str) {
+        match result {
+            Err(HandlerError::Port(PortError::Invalid {
+                field: found,
+                why: reason,
+            })) => {
+                assert_eq!(found, field);
+                assert_eq!(reason, why);
+            }
+            other => panic!("expected an invalid {field}, got {other:?}"),
+        }
+    }
+
+    #[test]
+    fn ori_t_0187_the_handlers_fallbacks_never_panic() {
+        let mut rig = rig(Role::Coder, "fallbacks", true);
+        let ticket = ticket_t();
+        let good = |kind: Value, content: Value| json!({"ticket_id": ticket.as_str(), "kind": kind, "content": content});
+
+        // No ticket on the call.
+        assert_invalid(
+            direct(
+                &mut rig,
+                None,
+                good(json!("blocked"), json!(content_of(&BLOCKED_FIELDS))),
+            ),
+            "ticket_id",
+            WHY_TICKET,
+        );
+
+        // A kind that is missing, not a string, or not one of the four.
+        for kind in [Value::Null, json!(7), json!("incident"), json!("Closing")] {
+            assert_invalid(
+                direct(
+                    &mut rig,
+                    Some(&ticket),
+                    good(kind, json!(content_of(&BLOCKED_FIELDS))),
+                ),
+                "kind",
+                WHY_KIND,
+            );
+        }
+        assert_invalid(
+            direct(
+                &mut rig,
+                Some(&ticket),
+                json!({"content": content_of(&BLOCKED_FIELDS)}),
+            ),
+            "kind",
+            WHY_KIND,
+        );
+
+        // A content that is missing or not an object.
+        for content in [Value::Null, json!("text"), json!([1, 2]), json!(7)] {
+            assert_invalid(
+                direct(&mut rig, Some(&ticket), good(json!("blocked"), content)),
+                "content",
+                WHY_CONTENT,
+            );
+        }
+        assert_invalid(
+            direct(&mut rig, Some(&ticket), json!({"kind": "blocked"})),
+            "content",
+            WHY_CONTENT,
+        );
+
+        // A field that is not a string.
+        let mut content = content_of(&BLOCKED_FIELDS);
+        content.insert("hypothesis".to_owned(), json!(7));
+        assert_invalid(
+            direct(
+                &mut rig,
+                Some(&ticket),
+                good(json!("blocked"), json!(content)),
+            ),
+            "/content/hypothesis",
+            WHY_NOT_TEXT,
+        );
+
+        // An extra key: `why` is the fixed sentence and holds no part of it.
+        let mut content = content_of(&BLOCKED_FIELDS);
+        content.insert(MARKER.to_owned(), json!("text"));
+        let result = direct(
+            &mut rig,
+            Some(&ticket),
+            good(json!("blocked"), json!(content)),
+        );
+        match &result {
+            Err(HandlerError::Port(PortError::Invalid { why, .. })) => {
+                assert!(!why.contains(MARKER) && !why.contains("ZEBRA"), "{why}");
+            }
+            other => panic!("expected an invalid content, got {other:?}"),
+        }
+        assert_invalid(result, "content", WHY_UNEXPECTED);
+
+        assert_eq!(rig.draws(), 0, "every fault came before an identifier");
+    }
