+    #[test]
+    fn ori_t_0163_a_found_loss_delivered_beside_another_keeps_its_place_and_time() {
+        let scratch = Scratch::new("rootgone-found-beside");
+        let root = scratch.dir("root");
+        let mut watcher = TreeWatcher::watch_with(&root, quick()).unwrap();
+        fs::remove_dir_all(&root).unwrap();
+
+        let token = watcher.begin_reconcile();
+        assert!(
+            !watcher.mark_reconciled(token),
+            "a removed root was reconciled as healthy"
+        );
+        let found_at = held_missed_state(&watcher).first_observed_at;
+        std::thread::sleep(Duration::from_millis(20));
+        watcher.inject(Raw::Missed(MissedReason::Overflow, now()));
+
+        let batches = drain_until_quiet(&mut watcher);
+        let carrying: Vec<&MissedChanges> = batches
+            .iter()
+            .filter_map(|batch| batch.missed.as_ref())
+            .filter(|missed| missed.reasons.contains(&MissedReason::RootGone))
+            .collect();
+        assert_eq!(
+            carrying.len(),
+            1,
+            "the loss a reconciliation found must reach exactly one batch; got {batches:?}"
+        );
+        let delivered = carrying[0];
+        assert_eq!(
+            delivered.reasons,
+            vec![MissedReason::RootGone, MissedReason::Overflow]
+        );
+        assert_eq!(delivered.occurrences, 2);
+        assert_eq!(delivered.first_observed_at, found_at);
